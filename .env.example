# Copy to .env ON THE SERVER (/var/www/webapp-test/.env) — never commit the real file.

# Public address of the app (used in email links)
APP_URL=https://test.buchinger-science.com

# Password for https://test.buchinger-science.com/admin (at least 8 characters)
ADMIN_PASSWORD=change-me-to-something-long

# Brevo SMTP (Brevo → Settings → SMTP & API → SMTP). Leave SMTP_HOST empty to only log emails.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
MAIL_FROM=Inner Calm Study <study@buchinger-science.com>
